# ---------------------------------------------------------------------------
# Kamix — Combined frontend + backend for Render (single container).
#
# Runs:
#   1. Convex backend on port 3210
#   2. Nginx frontend on port 80 (static files)
#
# Both ports exposed; Render routes traffic to port 80.
# The Convex backend is used by the frontend via relative URL or localhost.
# ---------------------------------------------------------------------------
FROM node:20-slim AS frontend-build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

ARG VITE_CONVEX_URL=http://localhost:3210
ENV VITE_CONVEX_URL=$VITE_CONVEX_URL
COPY . .
RUN npm run build

# ---------------------------------------------------------------------------
FROM node:20-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends wget ca-certificates nginx \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Convex backend deps
COPY package.json package-lock.json ./
RUN npm ci --omit=dev 2>/dev/null || npm install --omit=dev

# Convex function sources
COPY src/convex/ ./src/convex/
COPY src/lib/ ./src/lib/
COPY convex.config.ts convex.json ./

# Frontend static files (from build stage)
COPY --from=frontend-build /app/dist /usr/share/nginx/html

# Nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Environment
ENV CONVEX_SITE_URL=http://localhost:3210 \
    NODE_ENV=production \
    CONVEX_DATA_DIR=/app/data \
    VLY_CONVEX_AUTH_ISSUER=https://freebuff.com

RUN mkdir -p /app/data

EXPOSE 80

COPY docker/render-entrypoint.sh /app/render-entrypoint.sh
RUN chmod +x /app/render-entrypoint.sh

ENTRYPOINT ["/app/render-entrypoint.sh"]
