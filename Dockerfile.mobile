# ---------------------------------------------------------------------------
# Kamix — Android APK builder (Capacitor).
#
# Builds an installable APK inside Docker so you don't need Android Studio or
# a local JDK/SDK. The web bundle, Android platform and Gradle build all run
# here; the finished APK is copied to the host via the compose bind mount.
#
#   docker compose build apk     # ~5–10 min first time (SDK + Gradle deps)
#   docker compose run --rm apk  # copies apk/kamix-debug.apk to ./apk/
#
# Rebuilds after code changes reuse the cached layers (deps → source → gradle).
# ---------------------------------------------------------------------------
FROM node:20-bookworm

ENV ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 \
    PATH="${PATH}:/opt/android-sdk/platform-tools:/opt/android-sdk/cmdline-tools/latest/bin"

# JDK 17 (required by Capacitor 8 / AGP 8) + download tools
RUN apt-get update \
 && apt-get install -y --no-install-recommends openjdk-17-jdk unzip wget \
 && rm -rf /var/lib/apt/lists/*

# Android command-line tools, licenses, and the SDK packages the build needs
RUN mkdir -p "${ANDROID_HOME}/cmdline-tools" \
 && wget -q https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -O /tmp/cmdtools.zip \
 && unzip -q /tmp/cmdtools.zip -d "${ANDROID_HOME}/cmdline-tools" \
 && mv "${ANDROID_HOME}/cmdline-tools/cmdline-tools" "${ANDROID_HOME}/cmdline-tools/latest" \
 && rm /tmp/cmdtools.zip \
 && (yes | sdkmanager --licenses > /dev/null 2>&1 || true) \
 && sdkmanager "platform-tools" "platforms;android-35" "build-tools;35.0.0" > /dev/null

WORKDIR /app

# Dependencies first (cached until package.json / lockfile change)
COPY package.json package-lock.json ./
RUN npm ci

# The Convex deployment URL is baked into the web bundle at build time.
ARG VITE_CONVEX_URL
ENV VITE_CONVEX_URL=${VITE_CONVEX_URL:-}

# Source, then the full APK build (uses scripts/build-apk.sh --docker)
COPY . .
RUN bash scripts/build-apk.sh --docker

# Copy the APK to the host-mounted ./apk/ volume when `docker compose run`
CMD ["bash", "-c", "mkdir -p /apk && cp /app/apk/kamix-debug.apk /apk/ && echo '✅ APK copied to ./apk/kamix-debug.apk' && ls -la /apk/"]
