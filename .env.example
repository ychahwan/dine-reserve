# ------------------------------------------------------------------
# Kamix — environment configuration (template)
# Copy to .env and fill in the values.
# ------------------------------------------------------------------

# Convex deployment URL — https://<project-slug>.convex.site
VITE_CONVEX_URL=

# Twilio SMS (server-side Convex env vars)
TWILIO_ACCOUNT_SID=
