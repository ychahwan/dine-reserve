# ------------------------------------------------------------------
# Kamix — environment configuration (template)
# Copy to .env and fill in the values.
# ------------------------------------------------------------------

# Convex deployment URL — https://<project-slug>.convex.site
VITE_CONVEX_URL=

# Public, shareable base URL of the deployed web app (used for invite links).
# Required for correct share links inside the mobile (Capacitor) build, since
# window.location.origin there resolves to an internal "localhost" address.
VITE_PUBLIC_APP_URL=https://kamix.app

# Twilio SMS — used server-side by Convex actions. Set TWILIO_ENABLED to
# "false" to disable ALL SMS sending (kill-switch).
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Twilio API Key (preferred — used instead of the main Auth Token for Basic
# Auth). When present, twilioConfig() uses API Key + Secret instead of the
# main Auth Token. Twilio API Keys authenticate as themselves, never as the
# Account SID.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Optional: Messaging Service SID (routes more reliably in international
# markets like Lebanon than a raw US long code). When set, overrides the
# bare From number.
TWILIO_MESSAGING_SERVICE_SID=
