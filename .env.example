# ------------------------------------------------------------------
# Kamix — environment configuration
# Used by docker-compose (web build + runtime). Copy to .env and fill in.
# ------------------------------------------------------------------

# Convex deployment URL — the frontend talks to your hosted Convex backend.
# You can find this in the Convex dashboard (Settings → Deployment URL),
# it looks like https://<project-slug>.convex.site
VITE_CONVEX_URL=https://canny-leopard-341.convex.cloud

# Convex deploy key — used by `npx convex deploy` to push functions to the
# Convex Cloud deployment above (dashboard: youssef-chahwan/kamix/canny-leopard-341).
# NEVER commit this file — it is gitignored.
CONVEX_DEPLOY_KEY=dev:canny-leopard-341|eyJ2MiI6ImQwOTYyZjAzOWJhOTQyZGViNTVkYjI3YjJlMWU3NWNmIn0=

# Render API key + project — only needed if/when an additional service must
# be deployed to Render (e.g. self-hosted Convex fallback, web hosting).
RENDER_API_KEY=rnd_aZfObBYYlRhRq92Fe5OWqK6mfnXC
RENDER_PROJECT_ID=prj-da25ovn40ujc7397ee20

# Twilio SMS — used server-side by Convex actions. In the Freebuff/Convex
# cloud these are set via the project's Keys/API keys tab or:
#   npx convex env set TWILIO_ACCOUNT_SID ...
#   npx convex env set TWILIO_AUTH_TOKEN ...
#   npx convex env set TWILIO_FROM_NUMBER ...
# (docker-compose also forwards them to the container for self-hosting.)
# Set to "false" to disable ALL SMS sending (kill-switch).
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=AC8c826b5fc36a9bcade76cd3fcf2baf1a
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+19894614479

# Twilio API Key (used instead of the main Auth Token, which Twilio never
# exposes via API). Preferred by src/convex/sms.ts's twilioConfig() helper
# when present.
TWILIO_API_KEY_SID=SK2be5c3e82d221a7050d683e431533fb5
TWILIO_API_KEY_SECRET=Ok5vARWEAI6amWOK1xADyzipBydqf5XX

TWILIO_MESSAGING_SERVICE_SID=MGedeec42536e27dfec9a0bf32577d4543
VITE_PUBLIC_APP_URL=https://kamix.app