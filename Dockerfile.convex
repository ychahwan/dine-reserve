# ---------------------------------------------------------------------------
# Kamix — Self-hosted Convex backend (Docker).
#
# Runs the Convex development backend inside a container.  On first boot
# the CLI downloads the backend binary, pushes your functions, and starts
# the API server on port 3210.
#
# IMPORTANT: Uses Debian-based Node image (NOT Alpine) because the Convex
# local backend binary is compiled against glibc.
#
# Usage (standalone):
#   docker build -f Dockerfile.convex -t kamix-convex .
#   docker run -p 3210:3210 -v convex-data:/app/data kamix-convex
#
# Usage (docker-compose — the recommended way):
#   docker compose up convex
# ---------------------------------------------------------------------------
FROM node:20-slim

# Install wget for the health check in the entrypoint script.
RUN apt-get update \
 && apt-get install -y --no-install-recommends wget ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 1. Install production deps (convex + function dependencies).
COPY package.json package-lock.json ./
RUN npm ci --omit=dev 2>/dev/null || npm install --omit=dev

# 2. Copy Convex backend sources.
#    Functions may import from src/lib/ (shared utilities), so copy that too.
COPY src/convex/ ./src/convex/
COPY src/lib/ ./src/lib/
COPY convex.config.ts convex.json ./

# 3. Environment.
#
#    CONVEX_SITE_URL — the URL the backend uses to self-reference (OIDC,
#    session tokens, etc.).  Override this with the public URL when
#    deploying behind a reverse proxy or on Render.
#
#    CONVEX_DEPLOYMENT — identifies the local deployment for the CLI.
#    Set automatically by `npx convex dev` on first run.
ENV CONVEX_SITE_URL=http://localhost:3210 \
    NODE_ENV=development \
    CONVEX_DATA_DIR=/app/data \
    VLY_CONVEX_AUTH_ISSUER=https://freebuff.com

RUN mkdir -p /app/data

EXPOSE 3210

# 4. Entrypoint.
COPY docker/convex-entrypoint.sh /app/convex-entrypoint.sh
RUN chmod +x /app/convex-entrypoint.sh

ENTRYPOINT ["/app/convex-entrypoint.sh"]
